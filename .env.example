# Copy this file to ".env" and fill it in.  .env is in .gitignore — it must NEVER go to GitHub.

# Developer Portal → your app → Bot → Reset Token → paste here (no quotes needed)
DISCORD_TOKEN=PASTE_YOUR_NEW_BOT_TOKEN_HERE

# Discord: Settings → Advanced → Developer Mode ON → right-click the server icon → Copy Server ID
GUILD_ID=

# Your own Discord user ID (right-click your name → Copy User ID). Comma-separate for more admins.
# The server owner is always admin. If empty, anyone with Administrator permission is admin.
ADMIN_IDS=
